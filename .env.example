VITE_API_URL=/api
# Producción (Render static): URL ABSOLUTA de la API en Render. Sin esto → Failed to fetch en el celu.
# VITE_API_URL=https://salta-delivery-api.onrender.com/api
#
# Socket.io (flota / viajes en vivo).
# Opcional en local; por defecto usa el origin de Vite (proxy /socket.io → :3000).
# VITE_SOCKET_URL=http://localhost:3000
# En Render:
# VITE_SOCKET_URL=https://salta-delivery-api.onrender.com
#
# Mapbox GL — opcional para mapas admin.
VITE_MAPBOX_TOKEN=
