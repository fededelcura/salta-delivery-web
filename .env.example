VITE_API_URL=/api
# Producción (Vercel): URL absoluta de la API Node (Railway/Render), ej:
# VITE_API_URL=https://salta-delivery-api.up.railway.app/api
#
# Socket.io del panel admin (flota / viajes en vivo).
# Opcional en local; por defecto usa el origin de Vite (proxy /socket.io → :3000).
# VITE_SOCKET_URL=http://localhost:3000
# En Vercel, si la API está en otro dominio:
# VITE_SOCKET_URL=https://salta-delivery-api.up.railway.app
#
# Mapbox GL — opcional para mapas admin. Sin token el panel muestra placeholder.
# Creá un token en https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=
